<mxfile host="drawio-desktop" type="device">
  <diagram id="qgc-setup-workflow" name="QGroundControl setup">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="320" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s1" value="1. Connect the FC&#10;over USB-C" style="rounded=1;html=0;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1.5;fontColor=#1b1b1b;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="s2" value="2. Flash firmware&#10;ArduCopter 4.6.3, fmuv3" style="rounded=1;html=0;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1.5;fontColor=#1b1b1b;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="40" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="s3" value="3. Airframe&#10;Quad X" style="rounded=1;html=0;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1.5;fontColor=#1b1b1b;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="440" y="40" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="s4" value="4. Sensor calibration&#10;accel · compass · level (indoors)" style="rounded=1;html=0;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1.5;fontColor=#1b1b1b;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="40" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="s5" value="5. Radio calibration&#10;n/a: no RC transmitter" style="rounded=1;html=0;fillColor=#ffffff;strokeColor=#9e9e9e;strokeWidth=1.5;dashed=1;fontColor=#757575;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="840" y="40" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="s6" value="6. Motor test&#10;order + spin direction OK" style="rounded=1;html=0;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1.5;fontColor=#1b1b1b;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="840" y="180" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="s7" value="7. ESC calibration&#10;done (propellers OFF)" style="rounded=1;html=0;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1.5;fontColor=#1b1b1b;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="180" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="s8" value="8. Power settings&#10;not configured yet" style="rounded=1;html=0;fillColor=#ffffff;strokeColor=#1e3c78;strokeWidth=1.5;fontColor=#1b1b1b;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="440" y="180" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#1e3c78;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#1e3c78;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#1e3c78;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#1e3c78;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#1e3c78;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e67" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#1e3c78;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e78" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#1e3c78;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="Typical first-setup order in QGroundControl. Green: done · white: not configured · grey: not applicable (no RC transmitter, the drone is flown over the telemetry link)." style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;fontFamily=Helvetica;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="265" width="960" height="20" as="geometry"/></mxCell>
      </root>
